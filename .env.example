# Copy to .env and replace every placeholder. This file is read only by scripts/start.ps1.
DB_PASSWORD=YOUR_DATABASE_PASSWORD
MINIO_ACCESS_KEY=YOUR_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=YOUR_MINIO_SECRET_KEY
JWT_SECRET=YOUR_JWT_SECRET
# Required only when app.demo-admin.enabled is true.
DEMO_ADMIN_PASSWORD=YOUR_DEMO_ADMIN_PASSWORD
AI_CLOUD_API_KEY=
# Used by a production Vite build. The startup script supplies this automatically for dev mode.
VITE_API_BASE_URL=http://localhost:8081
