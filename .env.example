# Copy to .env and replace every placeholder. This file is read only by scripts/start.ps1.
DB_PASSWORD=YOUR_DATABASE_PASSWORD
MINIO_ACCESS_KEY=YOUR_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=YOUR_MINIO_SECRET_KEY
# Required for JWT HS256: use a cryptographically random value of at least 32 UTF-8 bytes.
JWT_SECRET=YOUR_JWT_SECRET_AT_LEAST_32_BYTES
# Required only when app.demo-admin.enabled is true.
DEMO_ADMIN_PASSWORD=YOUR_DEMO_ADMIN_PASSWORD
AI_CLOUD_API_KEY=
# Directory containing vie.traineddata and eng.traineddata. Tess4J bundles English;
# set this for Vietnamese invoices (for example C:/tesseract/tessdata).
TESSDATA_PATH=
OCR_LANGUAGE=vie+eng
OCR_ENABLED=true
# Limits output/KV-cache memory for local vision models; raise only when JSON is truncated.
OLLAMA_NUM_PREDICT=2048
# Must stay aligned with the upload limit shown by the frontend.
UPLOAD_MAX_FILE_SIZE=10MB
UPLOAD_MAX_REQUEST_SIZE=12MB
# Used by a production Vite build. The startup script supplies this automatically for dev mode.
VITE_API_BASE_URL=http://localhost:8081
